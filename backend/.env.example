# Copy to backend/.env (never commit the real file).

# Database. Default: SQLite file at backend/data/horseiq.db
# PostgreSQL / Supabase example (pip install "psycopg[binary]"):
# DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<project>.supabase.co:5432/postgres
DATABASE_URL=

# TJK data service. Only with a key issued by TJK (no key = feature disabled).
TJK_AUTH_KEY=
TJK_API_BASE_URL=https://vhs.tjk.org/vss/data

# Accurace tracking API (licence pending).
ACCURACE_API_KEY=
ACCURACE_API_BASE_URL=

CORS_ORIGINS=http://localhost:5173
